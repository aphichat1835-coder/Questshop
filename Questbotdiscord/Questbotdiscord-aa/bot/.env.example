# Required — set these six primary values on every process.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
OWNER_ID=
RUNNER_TOKEN_SECRET=
LOG_WEBHOOK_URL=

# Process topology.
# all     = Discord control plane + One-shot + Auto Daily in one process (default/recommended).
# control = Discord Gateway, commands and One-shot; Auto Daily is delegated through SQLite.
# worker  = Auto Daily only, REST status output, no Discord Gateway session.
QUEST_PROCESS_ROLE=all
# Split control/worker processes must use the same durable DATABASE_PATH and
# RUNNER_TOKEN_SECRET. Never run role=all at the same time as control/worker.
QUEST_WORKER_POLL_MS=5000

# Optional bot access and output overrides.
TIMEZONE=Asia/Bangkok
LOG_CHANNEL_ID=
MANAGER_ROLE_ID=

# Storage is selected automatically when these are blank.
# Writable /var/data      → /var/data/quests.db, persistent-candidate
# Local development      → ./data/quests.db, local-development
# Hosted without a mount → ./data/quests.db, hosted-ephemeral warning
# :memory:               → backup is always disabled
DATABASE_PATH=
DATABASE_BACKUP_ENABLED=
DATABASE_BACKUP_RETENTION=7

# Optional Bearer token for HTTP GET /api/status. The endpoint is disabled when empty.
HEALTH_STATUS_TOKEN=

# Each simultaneously running control/worker process needs its own listening port.
# Single-process hosting normally supplies PORT automatically.
PORT=

# Fixed Discord client profile — optional overrides must be updated as one complete set.
DISCORD_CLIENT_VERSION=
DISCORD_CHROME_VERSION=
DISCORD_ELECTRON_VERSION=
DISCORD_BUILD_NUMBER=
DISCORD_NATIVE_BUILD_NUMBER=
DISCORD_LOCALE=en-US
DISCORD_TIMEZONE=Asia/Bangkok
