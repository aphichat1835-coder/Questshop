{
  "name": "questshop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "register": "node scripts/register-commands.js",
    "migrate": "node scripts/migrate.js",
    "backup": "node scripts/backup.js",
    "restore:drill": "node scripts/restore-drill.js",
    "prelaunch:closeout": "node scripts/prelaunch-closeout.js",
    "load:test": "node scripts/load-test.js",
    "check": "find src scripts test -type f -name '*.js' -print0 | xargs -0 -n1 node --check",
    "lint": "eslint src scripts test",
    "test": "node --test --test-concurrency=1 test/*/*.test.js",
    "test:unit": "node --test test/unit/*.test.js",
    "test:integration": "node --test --test-concurrency=1 test/{integration,concurrency,crash}/*.test.js",
    "verify": "npm run check && npm run lint && npm test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1101.0",
    "@aws-sdk/lib-storage": "3.1101.0",
    "discord.js": "14.27.0",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "uuid": "14.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "eslint": "10.8.0",
    "fast-check": "4.9.0"
  }
}
