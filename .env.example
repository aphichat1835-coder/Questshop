NODE_ENV=production
PORT=3000
TIMEZONE=Asia/Bangkok
PRELAUNCH=true

DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
OWNER_ID=
STATUS_TOKEN=

DATABASE_POOL_URL=postgresql://questshop_runtime:password@host:5432/questshop?sslmode=verify-full
DATABASE_DIRECT_URL=postgresql://questshop_migrator:password@host:5432/questshop?sslmode=verify-full
BACKUP_ENABLED=true
DATABASE_BACKUP_URL=postgresql://questshop_backup:password@host:5432/questshop?sslmode=verify-full
DATABASE_RESTORE_URL=postgresql://questshop_restore:password@host:5432/postgres?sslmode=verify-full
DATABASE_SSL_CA_BASE64=
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore

# JSON: {"current":1,"keys":{"1":"BASE64_32_BYTE_KEY"}}
DATA_ENCRYPTION_KEYS_JSON=
VOUCHER_HMAC_KEYS_JSON=
BACKUP_ENCRYPTION_KEYS_JSON=

S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

RUNNER_CONCURRENCY=3
RUNNER_CONCURRENCY_HARD_MAX=5
GIT_SHA=unknown
DISCORD_CLIENT_VERSION=1.0.9267
DISCORD_CHROME_VERSION=138.0.7204.251
DISCORD_ELECTRON_VERSION=37.6.0
DISCORD_BUILD_NUMBER=572700
DISCORD_NATIVE_BUILD_NUMBER=47491
DISCORD_LOCALE=en-US
